#!/bin/bash
# Managed by devhome/ansible/periscope.yml — DNAT public UDP media ports to the
# devhome box over the tailnet (HAProxy does not proxy UDP). Idempotent.
set -euo pipefail
PUB_IF=$(ip route show default | awk '{print $5; exit}')
for port in {{ devhome_forward_udp | join(' ') }}; do
  iptables -t nat -C PREROUTING -i "$PUB_IF" -p udp --dport "$port" -j DNAT --to-destination {{ box_tailscale_ip }}:"$port" 2>/dev/null \
    || iptables -t nat -A PREROUTING -i "$PUB_IF" -p udp --dport "$port" -j DNAT --to-destination {{ box_tailscale_ip }}:"$port"
  iptables -C FORWARD -p udp -d {{ box_tailscale_ip }} --dport "$port" -j ACCEPT 2>/dev/null \
    || iptables -A FORWARD -p udp -d {{ box_tailscale_ip }} --dport "$port" -j ACCEPT
done
iptables -C FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
  || iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -t nat -C POSTROUTING -o tailscale0 -d {{ box_tailscale_ip }} -j MASQUERADE 2>/dev/null \
  || iptables -t nat -A POSTROUTING -o tailscale0 -d {{ box_tailscale_ip }} -j MASQUERADE
