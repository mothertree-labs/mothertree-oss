#!/bin/bash

# Manage Stalwart Mailing List Groups
# Creates, updates, lists, and deletes mailing list groups via the Stalwart API
#
# Usage:
#   Create group / add members:
#     ./scripts/manage-group --tenant=<name> --env=<env> <list-name> [member1] [member2] ...
#   Show group details (no members given):
#     ./scripts/manage-group --tenant=<name> --env=<env> <list-name>
#   List all groups:
#     ./scripts/manage-group --tenant=<name> --env=<env> --list
#   Remove members from group:
#     ./scripts/manage-group --tenant=<name> --env=<env> --remove <list-name> <member1> [member2] ...
#   Delete group:
#     ./scripts/manage-group --tenant=<name> --env=<env> --delete <list-name>
#
# Examples:
#   ./scripts/manage-group --tenant=<name> --env=dev team-all user@dev.example.com
#   ./scripts/manage-group --tenant=<name> --env=dev --list
#   ./scripts/manage-group --tenant=<name> --env=dev --remove team-all user@dev.example.com
#   ./scripts/manage-group --tenant=<name> --env=dev --delete team-all
#
# Members are email addresses; a bare name means <name>@<tenant email domain>.
# Uses the Stalwart v1 JMAP management API (x:MailingList) through
# scripts/lib/stalwart-jmap.py.

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_status()  { echo -e "${BLUE}[INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}[OK]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
print_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

REPO="${REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
REPO_ROOT="$REPO"
source "${REPO_ROOT}/scripts/lib/paths.sh"
TENANT=""
MT_ENV=""
ACTION=""  # "", "list", "remove", "delete"
LIST_NAME=""
MEMBERS=()

usage() {
    echo "Usage:"
    echo "  $0 --tenant=<name> --env=<env> <list-name> [member1] [member2] ..."
    echo "  $0 --tenant=<name> --env=<env> --list"
    echo "  $0 --tenant=<name> --env=<env> --remove <list-name> <member1> [member2] ..."
    echo "  $0 --tenant=<name> --env=<env> --delete <list-name>"
    echo ""
    echo "Options:"
    echo "  --tenant=<name>   Tenant name (directory in tenants/)"
    echo "  --env=<env>       Environment (dev, prod)"
    echo "  --list            List all groups for this tenant"
    echo "  --remove          Remove the specified members from the group"
    echo "  --delete          Delete the group entirely"
    echo "  -h, --help        Show this help"
    echo ""
    echo "When called with a list name and no members, shows group details."
    echo "When called with a list name and members, creates the group or adds members."
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --tenant=*)
            TENANT="${1#*=}"
            shift
            ;;
        --env=*)
            MT_ENV="${1#*=}"
            shift
            ;;
        --list)
            ACTION="list"
            shift
            ;;
        --remove)
            ACTION="remove"
            shift
            ;;
        --delete)
            ACTION="delete"
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            print_error "Unknown option: $1"
            usage
            exit 1
            ;;
        *)
            if [ -z "$LIST_NAME" ]; then
                LIST_NAME="$1"
            else
                MEMBERS+=("$1")
            fi
            shift
            ;;
    esac
done

# Validate required parameters
if [ -z "$TENANT" ]; then
    print_error "--tenant=<name> is required"
    usage
    exit 1
fi

if [ -z "$MT_ENV" ]; then
    print_error "--env=<env> is required"
    usage
    exit 1
fi

if [ "$ACTION" != "list" ] && [ -z "$LIST_NAME" ]; then
    print_error "List name is required (or use --list to see all groups)"
    usage
    exit 1
fi

if [ "$ACTION" = "remove" ] && [ ${#MEMBERS[@]} -eq 0 ]; then
    print_error "--remove requires at least one member email"
    usage
    exit 1
fi

# Load tenant config
_mt_resolve_tenants_dir
TENANT_DIR="$MT_TENANTS_DIR/$TENANT"
TENANT_CONFIG="$TENANT_DIR/$MT_ENV.config.yaml"
TENANT_SECRETS="$TENANT_DIR/$MT_ENV.secrets.yaml"

if [ ! -f "$TENANT_CONFIG" ]; then
    print_error "Tenant config not found: $TENANT_CONFIG"
    exit 1
fi

if [ ! -f "$TENANT_SECRETS" ]; then
    print_error "Tenant secrets not found: $TENANT_SECRETS"
    exit 1
fi

export KUBECONFIG="$REPO/kubeconfig.$MT_ENV.yaml"

TENANT_DOMAIN=$(yq '.dns.domain' "$TENANT_CONFIG")
ENV_DNS_LABEL=$(yq '.dns.env_dns_label // ""' "$TENANT_CONFIG")
STALWART_ADMIN_PASSWORD=$(yq '.stalwart.admin_password' "$TENANT_SECRETS")

if [ -z "$STALWART_ADMIN_PASSWORD" ] || [ "$STALWART_ADMIN_PASSWORD" = "null" ]; then
    print_error "Stalwart admin password not found in $TENANT_SECRETS"
    exit 1
fi

# Build email domain
if [ -n "$ENV_DNS_LABEL" ] && [ "$ENV_DNS_LABEL" != "null" ]; then
    EMAIL_DOMAIN="${ENV_DNS_LABEL}.${TENANT_DOMAIN}"
else
    EMAIL_DOMAIN="${TENANT_DOMAIN}"
fi

NS_MAIL="tn-${TENANT}-mail"

# Set up port-forward
LOCAL_PORT=$((RANDOM % 10000 + 20000))

print_status "Connecting to Stalwart in $NS_MAIL..."
kubectl port-forward -n "$NS_MAIL" deployment/stalwart ${LOCAL_PORT}:8080 &>/dev/null &
PF_PID=$!
sleep 3

if ! kill -0 $PF_PID 2>/dev/null; then
    print_error "Port-forward to Stalwart failed"
    print_error "Check pod status: kubectl get pods -n $NS_MAIL"
    exit 1
fi

cleanup() {
    kill $PF_PID 2>/dev/null && wait $PF_PID 2>/dev/null || true
}
trap cleanup EXIT


# Stalwart v1 JMAP management API (x:MailingList/*) via the shared helper.
# Groups are mailing lists whose recipients are email addresses.
jmap() {
    STALWART_URL="http://localhost:${LOCAL_PORT}" STALWART_ADMIN_PASSWORD="$STALWART_ADMIN_PASSWORD" \
        python3 "$REPO_ROOT/scripts/lib/stalwart-jmap.py" "$@"
}

# A bare name means an address on the tenant's email domain.
to_address() {
    case "$1" in
        *@*) printf '%s\n' "$1" ;;
        *)   printf '%s@%s\n' "$1" "$EMAIL_DOMAIN" ;;
    esac
}

LIST_EMAIL=""
if [ -n "$LIST_NAME" ]; then
    LIST_EMAIL=$(to_address "$LIST_NAME")
fi
MEMBER_ADDRESSES=()
for member in "${MEMBERS[@]+"${MEMBERS[@]}"}"; do
    MEMBER_ADDRESSES+=("$(to_address "$member")")
done

# ---- Verify SMTP acceptance and flush Postfix cache ----
verify_and_flush_cache() {
    local email="$1"
    local stalwart_svc="stalwart.${NS_MAIL}.svc.cluster.local"

    # Find the K8s Postfix pod
    local postfix_pod
    postfix_pod=$(kubectl get pods -n infra-mail --field-selector=status.phase=Running -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)

    if [ -z "$postfix_pod" ]; then
        print_warning "Could not find Postfix pod in infra-mail — skipping cache flush"
        return
    fi

    # Poll Stalwart SMTP until it accepts the address (up to 30s)
    print_status "Verifying Stalwart accepts <$email> via SMTP..."
    local attempt=0
    local max_attempts=6
    while [ $attempt -lt $max_attempts ]; do
        local result
        result=$(kubectl exec -n infra-mail "$postfix_pod" -c postfix -- \
            python3 -c "
import smtplib, sys
try:
    s = smtplib.SMTP('${stalwart_svc}', 25, timeout=10)
    s.ehlo('verify.local')
    s.mail('verify@local')
    code, _ = s.rcpt('${email}')
    s.quit()
    print(code)
except Exception as e:
    print(f'err: {e}', file=sys.stderr)
    print(0)
" 2>/dev/null)

        if [ "$result" = "250" ]; then
            print_success "Stalwart accepts <$email>"
            break
        fi

        attempt=$((attempt + 1))
        if [ $attempt -lt $max_attempts ]; then
            sleep 5
        fi
    done

    if [ "$result" != "250" ]; then
        print_warning "Stalwart did not accept <$email> after ${max_attempts} attempts — cache not flushed"
        return
    fi

    # Flush the K8s Postfix verify cache entry
    print_status "Flushing K8s Postfix address verification cache..."
    kubectl exec -n infra-mail "$postfix_pod" -c postfix -- \
        sh -c "postmap -d '${email}' btree:/var/lib/postfix/verify 2>/dev/null; postfix reload" \
        >/dev/null 2>&1

    print_success "Postfix cache flushed for <$email>"
}


# ---- Action: list all groups ----
do_list() {
    print_status "Listing groups for $TENANT ($MT_ENV)..."
    local lists
    if ! lists=$(jmap lists); then
        print_error "Failed to list groups"
        exit 1
    fi

    local total
    total=$(echo "$lists" | jq 'length')

    if [ "$total" = "0" ]; then
        print_status "No groups found"
        return
    fi

    echo ""
    echo "$lists" | jq -r '.[] | "  \(.name)\t\(.emailAddress)\t(\(.recipients | length) members)"'
    echo ""
    print_status "$total group(s) found"
}

# ---- Action: show group details ----
do_show() {
    print_status "Fetching group '$LIST_EMAIL'..."
    local group rc=0
    group=$(jmap list-get "$LIST_EMAIL") || rc=$?
    if [ "$rc" = "4" ]; then
        print_error "Group '$LIST_EMAIL' does not exist"
        exit 1
    elif [ "$rc" != "0" ]; then
        print_error "Failed to fetch group"
        exit 1
    fi

    echo ""
    echo "  Name:    $(echo "$group" | jq -r '.name // "N/A"')"
    echo "  Email:   $(echo "$group" | jq -r '.emailAddress // "N/A"')"
    echo ""

    local member_count
    member_count=$(echo "$group" | jq -r '.recipients | length')

    if [ "$member_count" = "0" ]; then
        echo "  No members"
    else
        echo "  Members ($member_count):"
        echo "$group" | jq -r '.recipients[]' | while read -r m; do
            echo "    - $m"
        done
    fi
    echo ""
}

# ---- Action: create group or add members ----
do_create_or_add() {
    local rc=0
    jmap list-get "$LIST_EMAIL" > /dev/null || rc=$?

    if [ "$rc" = "0" ]; then
        # Group exists — add members
        if [ ${#MEMBER_ADDRESSES[@]} -eq 0 ]; then
            # No members specified, just show the group
            do_show
            return
        fi

        print_status "Group '$LIST_EMAIL' exists, adding ${#MEMBER_ADDRESSES[@]} member(s)..."
        if jmap list-members "$LIST_EMAIL" --add "${MEMBER_ADDRESSES[@]}"; then
            print_success "Members added to '$LIST_EMAIL'"
            for member in "${MEMBER_ADDRESSES[@]}"; do
                echo "  + $member"
            done
        else
            print_error "Failed to add members"
            exit 1
        fi
    elif [ "$rc" = "4" ]; then
        # Group does not exist — create it
        print_status "Creating group <$LIST_EMAIL>..."
        local result
        if ! result=$(jmap list-create "$LIST_EMAIL" "Mailing list ${LIST_EMAIL%%@*} for $TENANT" \
                "${MEMBER_ADDRESSES[@]+"${MEMBER_ADDRESSES[@]}"}"); then
            print_error "Failed to create group"
            exit 1
        fi
        if [ "$result" = "exists" ]; then
            print_warning "Group '$LIST_EMAIL' already exists (race condition). Try again to add members."
        else
            print_success "Group '$LIST_EMAIL' created"
            if [ ${#MEMBER_ADDRESSES[@]} -gt 0 ]; then
                echo "  Members:"
                for member in "${MEMBER_ADDRESSES[@]}"; do
                    echo "    - $member"
                done
            fi
            jmap reload > /dev/null || print_warning "Stalwart settings reload failed"
            verify_and_flush_cache "$LIST_EMAIL"
        fi
    else
        print_error "Failed to look up group '$LIST_EMAIL'"
        exit 1
    fi
}

# ---- Action: remove members ----
do_remove() {
    print_status "Removing ${#MEMBER_ADDRESSES[@]} member(s) from '$LIST_EMAIL'..."
    local rc=0
    jmap list-members "$LIST_EMAIL" --remove "${MEMBER_ADDRESSES[@]}" || rc=$?
    if [ "$rc" = "0" ]; then
        print_success "Members removed from '$LIST_EMAIL'"
        for member in "${MEMBER_ADDRESSES[@]}"; do
            echo "  - $member"
        done
    elif [ "$rc" = "4" ]; then
        print_error "Group '$LIST_EMAIL' does not exist"
        exit 1
    else
        print_error "Failed to remove members"
        exit 1
    fi
}

# ---- Action: delete group ----
do_delete() {
    print_status "Deleting group '$LIST_EMAIL'..."
    local rc=0
    jmap list-delete "$LIST_EMAIL" || rc=$?
    if [ "$rc" = "0" ]; then
        print_success "Group '$LIST_EMAIL' deleted"
    elif [ "$rc" = "4" ]; then
        print_error "Group '$LIST_EMAIL' does not exist"
        exit 1
    else
        print_error "Failed to delete group"
        exit 1
    fi
}

# Dispatch
case "$ACTION" in
    list)
        do_list
        ;;
    remove)
        do_remove
        ;;
    delete)
        do_delete
        ;;
    *)
        do_create_or_add
        ;;
esac
