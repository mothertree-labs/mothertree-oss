# Lower CPU request than base for dev node packing; memory matches base.
# Usage observed at ~1015Mi (2026-08-15 eviction on tn-*-office): a 512Mi
# request made the pod the eviction victim under node memory pressure, and
# the old 1Gi limit sat exactly at real usage (OOMKill territory).
resources:
  requests:
    cpu: 100m
    memory: 1Gi
  limits:
    memory: 2Gi

collabora:
  server_name: '{{ env "OFFICE_HOST" }}'
  aliasgroups:
    - host: 'https://{{ env "FILES_HOST" }}:443'

ingress:
  enabled: true
  className: nginx
  annotations:
    nginx.ingress.kubernetes.io/upstream-hash-by: "$arg_WOPISrc"
    nginx.ingress.kubernetes.io/proxy-body-size: "0"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
  hosts:
    - host: '{{ env "OFFICE_HOST" }}'
      paths:
        - path: /
          pathType: Prefix
  tls:
    - secretName: 'wildcard-tls-{{ env "TENANT_NAME" }}'
      hosts:
        - '{{ env "OFFICE_HOST" }}'
