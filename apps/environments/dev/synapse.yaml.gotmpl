serverName: '{{ env "MATRIX_HOST" }}'
ingress:
  host: '{{ env "MATRIX_HOST" }}'
  tls:
    - secretName: 'wildcard-tls-{{ env "TENANT_NAME" }}'
      hosts:
        - '{{ env "MATRIX_HOST" }}'

# Stable secrets — prevents the chart from regenerating random values on every upgrade
config:
  registrationSharedSecret: {{ env "SYNAPSE_REGISTRATION_SHARED_SECRET" | quote }}
  macaroonSecretKey: {{ env "SYNAPSE_MACAROON_SECRET_KEY" | quote }}

# External PostgreSQL (shared instance in infra-db namespace)
externalPostgresql:
  host: {{ env "PG_HOST" | quote }}
  port: 5432
  username: {{ env "SYNAPSE_DB_USER" | quote }}
  password: {{ env "SYNAPSE_DB_PASSWORD" | quote }}
  database: {{ env "SYNAPSE_DB_NAME" | quote }}

redis:
  password: {{ env "SYNAPSE_REDIS_PASSWORD" | quote }}
  auth:
    password: {{ env "SYNAPSE_REDIS_PASSWORD" | quote }}

# Dev Synapse resources — must be under synapse: key for the ananace/matrix-synapse chart
# ~50% of prod to fit on a single dev node
synapse:
  resources:
    requests:
      cpu: 50m
      memory: 256Mi
    limits:
      memory: 1Gi

# Override extraConfig to update OIDC issuer for dev environment
# Note: This replaces the entire extraConfig section, so we must include all settings
# TURN server IP is extracted from phase1 outputs in create_env script
extraConfig:
  max_upload_size: 100M
  turn_uris:
    - 'turn:{{ env "TURN_SERVER_IP" }}:3478?transport=udp'
    - 'turn:{{ env "TURN_SERVER_IP" }}:3478?transport=tcp'
    - 'turn:{{ env "TURN_SERVER_IP" }}:3479?transport=udp'
    - 'turn:{{ env "TURN_SERVER_IP" }}:3479?transport=tcp'
  turn_shared_secret: {{ env "TURN_SHARED_SECRET" | quote }}
  # Explicitly disable email delegation (deprecated feature)
  account_threepid_delegates: {}
  # User directory — search_all_users enables Slack-like people search
  # (find any user on the homeserver, not just users sharing a room with you)
  user_directory:
    enabled: true
    search_all_users: true
    prefer_local_users: true
  # Email: the full `email:` block is defined in extraSecrets below so the
  # SMTP password lives in a K8s Secret (not a ConfigMap). The chart
  # concatenates extraSecrets into /synapse/config/conf.d/secrets.yaml at
  # pod start, which Synapse loads alongside homeserver.yaml.
  # Authentication is delegated to the Matrix Authentication Service (MAS,
  # #824): MAS signs users in through Keycloak and Synapse validates MAS
  # tokens. Under delegation Synapse refuses to start with password login,
  # registration or any SSO provider (oidc_providers) configured. The
  # matrix_authentication_service block itself is in extraSecrets below
  # (it carries the MAS shared secret).
  password_config:
    enabled: false
  experimental_features:
    # Sign in with QR code (MSC4108); requires MAS delegation.
    msc4108_enabled: true
  rc_message:
    per_second: 1000
    burst_count: 10000
  rc_login:
    address:
      per_second: 100
      burst_count: 100
    account:
      per_second: 0.5
      burst_count: 5
    failed_attempts:
      per_second: 1
      burst_count: 10
  rc_joins:
    local:
      per_second: 0.5
      burst_count: 20
    remote:
      per_second: 0.1
      burst_count: 10

# S3 credentials + SMTP submission credentials in extraSecrets (rendered as
# K8s Secret, not ConfigMap). The ananace/matrix-synapse chart merges these
# into /synapse/config/conf.d/secrets.yaml at pod start.
#
# SMTP_RELAY_* env vars are read from the `smtp-credentials` K8s Secret by
# deploy-matrix.sh before calling helmfile (the Secret is provisioned by
# scripts/provision-smtp-service-accounts before Matrix deploys in create_env).
extraSecrets:
  matrix_authentication_service:
    enabled: true
    endpoint: 'http://mas.{{ requiredEnv "NS_MATRIX" }}.svc.cluster.local:8080/'
    # Set by deploy-matrix.sh from the mas-config Secret (written by deploy-mas.sh).
    secret: {{ requiredEnv "MAS_SYNAPSE_SHARED_SECRET" | quote }}
  email:
    smtp_host: '{{ env "SMTP_RELAY_HOST" }}'
    smtp_port: {{ env "SMTP_RELAY_PORT" | default 588 }}
    smtp_user: '{{ env "SMTP_RELAY_USERNAME" }}'
    smtp_pass: '{{ env "SMTP_RELAY_PASSWORD" }}'
    # EMAIL_DOMAIN includes the env prefix (e.g. dev.<tenant>) so the From
    # address matches one of the aliases on the `mailer@` principal — required
    # for Stalwart's MAIL FROM alignment check on authenticated submission.
    notif_from: 'Matrix Notifications <noreply@{{ env "EMAIL_DOMAIN" }}>'
    enable_notifs: true
    require_transport_security: true
  media_storage_providers:
    - module: s3_storage_provider.S3StorageProviderBackend
      store_local: true
      store_remote: true
      store_synchronous: true
      config:
        bucket: {{ env "S3_MATRIX_BUCKET" }}
        region_name: {{ env "S3_CLUSTER" }}
        endpoint_url: '{{ env "S3_INTERNAL_ENDPOINT" }}'
        access_key_id: {{ env "S3_MATRIX_ACCESS_KEY" }}
        secret_access_key: {{ env "S3_MATRIX_SECRET_KEY" }}
