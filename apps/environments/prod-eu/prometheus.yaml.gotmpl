prometheus:
  prometheusSpec:
    # External label on every alert (and anything federated / remote-written).
    # prod-eu posts into the same Matrix room as prod through the same bot;
    # the bridge template prints "Cluster: <label>" to tell them apart.
    externalLabels:
      cluster: '{{ .Environment.Name }}'
  ingress:
    hosts:
      - 'prometheus.prod-eu.{{ env "INFRA_DOMAIN" }}'
    tls:
      - secretName: prometheus-tls
        hosts:
          - 'prometheus.prod-eu.{{ env "INFRA_DOMAIN" }}'

grafana:
  adminPassword: '{{ env "TF_VAR_grafana_admin_password" | default "changeme" }}'
  ingress:
    hosts:
      - 'grafana.prod-eu.{{ env "INFRA_DOMAIN" }}'
    tls:
      - secretName: grafana-tls
        hosts:
          - 'grafana.prod-eu.{{ env "INFRA_DOMAIN" }}'

alertmanager:
  ingress:
    hosts:
      - 'alertmanager.prod-eu.{{ env "INFRA_DOMAIN" }}'
    tls:
      - secretName: alertmanager-tls
        hosts:
          - 'alertmanager.prod-eu.{{ env "INFRA_DOMAIN" }}'
  # AlertManager configuration for prod-eu: Matrix + Healthchecks.io only.
  # No SMTP configured — prod-eu has no SES credentials and no K8s Postfix
  # (no tenant has features.mail_enabled=true), so email notifications are not
  # available here. Alerts flow to Matrix; the Watchdog pings Healthchecks.io.
  config:
    route:
      receiver: 'matrix-alerts'
      group_by: ['alertname', 'severity', 'namespace']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      routes:
        # Drop noisy internal alerts
        - match:
            alertname: InfoInhibitor
          receiver: 'null'
        # Dead man's switch: Watchdog always fires; Healthchecks.io alerts if pings stop
        - match:
            alertname: Watchdog
          receiver: 'deadman'
          group_interval: 1m
          repeat_interval: 1m
        # Weekly channel heartbeat (AlertChannelHeartbeat, always firing — see
        # alerting-heartbeat.rules): a room silent for more than a week means
        # the Matrix path is broken.
        - match:
            heartbeat: "true"
          receiver: 'matrix-alerts'
          group_wait: 0s
          repeat_interval: 168h
        # Deploy self-test (scripts/verify-alerting, run by ci-deploy.sh right
        # after deploy_infra): a synthetic AlertingSelfTest must reach Matrix
        # through the bridge within the gate's window, or the deploy is red.
        # Posted to the deploy room so the alerts room stays alert-only.
        - match:
            selftest: "true"
          receiver: 'selftest'
          group_wait: 0s
          group_interval: 1m
          repeat_interval: 1h
        # Out of band: "Alertmanager cannot deliver notifications" is the one
        # alert the Matrix channel may never carry. Flip the healthchecks
        # deadman check to failed at once (hc-ping /fail endpoint), and
        # continue down the routes so Matrix still gets it when it can.
        - match_re:
            alertname: 'Alertmanager(Cluster)?FailedToSendAlerts'
          receiver: 'deadman-fail'
          group_wait: 0s
          repeat_interval: 30m
          continue: true
        # Critical alerts: notify Matrix immediately and more frequently
        - match:
            severity: critical
          receiver: 'critical-alerts'
          repeat_interval: 1h
        # Non-critical alerts: Matrix at default cadence
        - match_re:
            severity: warning|info
          receiver: 'matrix-alerts'
    receivers:
      - name: 'null'
      # Room ID and deadman URL come from the infra tenant's secrets
      # (alertbot.room_id, healthchecks.deadman_url) via deploy_infra, which
      # refuses to run without them — no placeholder defaults here.
      - name: 'critical-alerts'
        webhook_configs:
          - url: 'http://matrix-alertmanager.{{ env "NS_MONITORING" }}.svc.cluster.local:3000/alerts/{{ requiredEnv "ALERTMANAGER_MATRIX_ROOM_ID" }}'
            send_resolved: true
      - name: 'deadman'
        webhook_configs:
          - url: '{{ requiredEnv "HEALTHCHECKS_DEADMAN_URL" }}'
            send_resolved: false
      - name: 'selftest'
        webhook_configs:
          # Deploy room when the infra tenant defines alertbot.deploy_room_id,
          # else the alerts room. Fire-only: a resolved self-test is noise.
          - url: 'http://matrix-alertmanager.{{ env "NS_MONITORING" }}.svc.cluster.local:3000/alerts/{{ env "DEPLOY_MATRIX_ROOM_ID" | default (requiredEnv "ALERTMANAGER_MATRIX_ROOM_ID") }}'
            send_resolved: false
      - name: 'deadman-fail'
        webhook_configs:
          # healthchecks.io ping URLs accept "/fail" to flip the check to failed
          # immediately; this is how a notification outage reaches a human when
          # Matrix cannot.
          - url: '{{ requiredEnv "HEALTHCHECKS_DEADMAN_URL" | trimSuffix "/" }}/fail'
            send_resolved: false
      - name: 'matrix-alerts'
        webhook_configs:
          - url: 'http://matrix-alertmanager.{{ env "NS_MONITORING" }}.svc.cluster.local:3000/alerts/{{ requiredEnv "ALERTMANAGER_MATRIX_ROOM_ID" }}'
            send_resolved: true
    inhibit_rules:
      # Don't send warning alerts if critical alert is already firing
      - source_match:
          severity: 'critical'
        target_match:
          severity: 'warning'
        equal: ['alertname', 'namespace']
