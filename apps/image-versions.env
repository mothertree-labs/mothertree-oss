# Which image versions to deploy.
# Updated manually (or by CI) when ready to roll out a new build.
#
# INVARIANT: each *_IMAGE_TAG here must equal its component's VERSION file.
# ci/scripts/version-check.sh enforces this on every PR and main push, because
# a pin behind its VERSION means CI built one image and the cluster pulls
# another -- silently (PERF_IMAGE_TAG sat at 0.1.0 through three perf/VERSION
# bumps, unnoticed because nothing consumed it yet).
#
# Deliberately pinning an older image -- a rollback, or build-now-deploy-later --
# therefore needs MT_ALLOW_PIN_DRIFT=1 on the pipeline, or the VERSION file
# reverted alongside. Without one of those the gate fails validate, which gates
# mothertree-build, which gates deploy-prod: the rollback would not deploy.
ADMIN_PORTAL_IMAGE_TAG=0.9.43
ACCOUNT_PORTAL_IMAGE_TAG=0.11.51
ROUNDCUBE_IMAGE_TAG=0.3.8
PERF_IMAGE_TAG=0.2.2
