sources:
  journald:
    type: journald
    include_units:
      - headscale
      - tailscaled
      - sshd

transforms:
  enrich:
    type: remap
    inputs: ["journald"]
    source: |
      .host = "{{ headscale_domain }}"
      .job = "headscale-vm"

sinks:
  loki:
    type: loki
    inputs: ["enrich"]
    endpoint: "{{ loki_push_url }}"
    # Vector's Loki healthcheck GETs /ready on the push URL; the in-cluster
    # Loki gateway answers 404 there, so it logged a failed healthcheck on
    # every start although pushes work. Delivery errors still surface as
    # sink errors.
    healthcheck:
      enabled: false
    encoding:
      codec: text
    labels:
      host: "{{ '{{' }} .host {{ '}}' }}"
      job: "headscale-vm"
      unit: "{{ '{{' }} ._SYSTEMD_UNIT {{ '}}' }}"
