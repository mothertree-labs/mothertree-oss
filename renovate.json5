// Renovate configuration — covers everything Dependabot cannot see.
//
// Division of labour (avoid duplicate PRs):
//   Dependabot (.github/dependabot.yml) owns: npm (portals, calendar-automation),
//     terraform (phase1, infra, ci/terraform), and the three Dockerfiles it
//     already tracks (admin-portal, account-portal, docker/roundcube — these
//     also feed .github/workflows/dependabot-version-bump.yml).
//   Renovate owns: container image tags embedded in Helm values, helmfile
//     chart versions, raw K8s manifests (*.yaml / *.yaml.tpl / *.yaml.gotmpl),
//     inline manifests in deploy-*.sh, Docs (root docs/), Ansible version pins,
//     Keycloak extension jars, and GitHub Actions.
//
// Why: CVE-2026-18963 (Keycloak) sat unnoticed because the tag lives in
// apps/values/keycloak-codecentric.yaml, which no Dependabot ecosystem parses.
//
// Policy: minor/patch bumps open PRs automatically (weekly), rate-limited to
// 2 PRs/hour and batched into groups so a bot run cannot flood CI. MAJOR bumps only
// appear on the Dependency Dashboard issue and need a checkbox tick — infra
// majors (Postgres client, kube-prometheus-stack, Ollama…) want a human.
//
// Validate locally:
//   npx --yes --package renovate@latest -- renovate-config-validator --strict renovate.json5
// Pin @latest: an unpinned `--package renovate` can resolve a cached 37.x from the
// npx store, which predates `managerFilePatterns` and reports 7 bogus errors.
// A local `RE2 not usable` warning is benign (native module build), not a config error.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 8am on wednesday"],
  // Rate limit. NOTE: prHourlyLimit caps how many PRs are opened per hour; it
  // does NOT space them out inside that hour. Setting it to 6 for "one every
  // 10 minutes" would still open all 6 back-to-back and then idle — which is
  // exactly the burst we are trying to avoid. A small number is what actually
  // produces spacing, so this is pinned to the dev tenant-lease capacity (2
  // pools): at most 2 PR pipelines can make progress at once anyway, and each
  // one is a full dev deploy plus 10 e2e shards.
  // Why this matters: on 2026-09-09 an unlimited batch opened 6 PRs in ~100s,
  // 9 pipelines; the resulting cancel-churn tripped the queue-unjam cron into
  // restarting Woodpecker and killing four live pipelines (see PR #648).
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "labels": ["dependencies", "renovate"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "rebaseWhen": "conflicted",
  "ignorePaths": [
    "**/node_modules/**",
    ".claude/**",
    "config/**",
    "apps/values/loki.yaml.helm-backup",
  ],

  // Only the managers Dependabot does NOT already run.
  "enabledManagers": ["custom.regex", "helmfile", "github-actions", "dockerfile"],

  "helmfile": {
    "managerFilePatterns": ["/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?$/"],
  },

  // Dockerfiles that Dependabot already owns stay with Dependabot.
  "dockerfile": {
    "ignorePaths": [
      "apps/admin-portal/**",
      "apps/account-portal/**",
      "apps/docker/roundcube/**",
    ],
  },

  "customManagers": [
    // 1. Inline `image: repo/name:tag` lines in K8s manifests, Helm values,
    //    Go-templated values, and heredoc manifests in deploy scripts.
    //    Regex-based on purpose: the YAML parsers choke on {{ }} / ${VAR}.
    //    `${PORTAL_IMAGE}`-style refs are skipped (no `$` allowed in depName).
    {
      "customType": "regex",
      "description": "Container image tags in manifests / values / deploy scripts",
      "managerFilePatterns": [
        "/^apps/(manifests|values|environments|templates)/.+\\.ya?ml(?:\\.tpl|\\.gotmpl)?$/",
        "/^apps/deploy-[^/]+\\.sh$/",
        "/^scripts/lib/nextcloud-db\\.sh$/",
        "/^apps/scripts/perf/build-k6-image\\.sh$/",
        "/^apps/loki-manual\\.yaml$/",
        "/^docs/.+\\.ya?ml(?:\\.tpl)?$/",
        "/^ansible/.+\\.ya?ml$/",
      ],
      "matchStrings": [
        "\\n[ \\t]*-?[ \\t]*image:[ \\t]*[\"']?(?<depName>[a-z0-9][a-z0-9._\\-]*(?:/[a-z0-9._\\-]+)*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._\\-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?",
        // Probe-Job image constant in scripts/lib/nextcloud-db.sh (#548).
        "\\nMT_NC_PROBE_IMAGE=\"(?<depName>[a-z0-9][a-z0-9._\\-]*(?:/[a-z0-9._\\-]+)*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._\\-]*)\"",
        // k6 base image default in apps/scripts/perf/build-k6-image.sh. This is
        // the pin that ACTUALLY wins: build-k6-image.sh passes it as
        // --build-arg K6_IMAGE=, overriding the ARG default in
        // perf/docker/k6-runner.Dockerfile. Managing only the Dockerfile left
        // the real pin unmanaged and 10 minor versions behind (0.49.0 vs
        // 0.59.0), so a Renovate bump there was a no-op.
        "\\nK6_IMAGE=\\$\\{K6_IMAGE:-(?<depName>[a-z0-9][a-z0-9._\\-]*(?:/[a-z0-9._\\-]+)*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._\\-]*)\\}",
      ],
      "datasourceTemplate": "docker",
    },

    // 2. Helm-values style `image: { repository: X, tag: Y }` blocks
    //    (Keycloak: apps/values/keycloak-codecentric.yaml — the CVE-2026-18963 gap).
    {
      "customType": "regex",
      "description": "Helm values image.repository + image.tag pairs",
      "managerFilePatterns": ["/^apps/values/.+\\.ya?ml(?:\\.gotmpl)?$/"],
      "matchStrings": [
        "repository:\\s*[\"']?(?<depName>[a-z0-9][a-z0-9._\\-]*(?:/[a-z0-9._\\-]+)*)[\"']?\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[A-Za-z0-9][A-Za-z0-9._\\-]*)[\"']?",
      ],
      "datasourceTemplate": "docker",
    },

    // 3. Keycloak magic-link extension jar (Maven Central), pinned as
    //    ML_VERSION="x.y" + ML_SHA256="..." in the fetch init container.
    //    Renovate bumps the version only; ML_SHA256 must be updated by hand
    //    (see prBodyNotes in the keycloak rule) — the init container's checksum
    //    gate refuses the jar and CI fails loudly until it is.
    {
      "customType": "regex",
      "description": "Keycloak magic-link extension version (Maven Central)",
      "managerFilePatterns": ["/^apps/values/keycloak-codecentric\\.yaml$/"],
      "matchStrings": ["ML_VERSION=\"(?<currentValue>\\d+(?:\\.\\d+)*)\""],
      "depNameTemplate": "io.phasetwo.keycloak:keycloak-magic-link",
      "datasourceTemplate": "maven",
    },

    // 4. Pandoc binary fetched by the Nextcloud install-pandoc init container.
    //    Version appears three times across two lines; rewrite the whole match.
    {
      "customType": "regex",
      "description": "Pandoc release tarball in Nextcloud init container",
      "managerFilePatterns": ["/^apps/values/nextcloud\\.yaml\\.gotmpl$/"],
      "matchStrings": [
        "jgm/pandoc/releases/download/(?<currentValue>\\d+(?:\\.\\d+)*)/pandoc-\\d+(?:\\.\\d+)*-linux-amd64\\.tar\\.gz(?<between>[^\\n]*\\n[^\\n]*?)pandoc-\\d+(?:\\.\\d+)*/bin/pandoc",
      ],
      "autoReplaceStringTemplate": "jgm/pandoc/releases/download/{{{newValue}}}/pandoc-{{{newValue}}}-linux-amd64.tar.gz{{{between}}}pandoc-{{{newValue}}}/bin/pandoc",
      "depNameTemplate": "jgm/pandoc",
      "datasourceTemplate": "github-releases",
    },

    // 5. Ansible version pins (Headscale control plane, Woodpecker CI server).
    {
      "customType": "regex",
      "description": "Headscale version in ansible/playbook.yml",
      "managerFilePatterns": ["/^ansible/playbook\\.yml$/"],
      "matchStrings": ["headscale_version:\\s*[\"'](?<currentValue>\\d+(?:\\.\\d+)*)[\"']"],
      "depNameTemplate": "juanfont/headscale",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
    },
    {
      "customType": "regex",
      "description": "Woodpecker version in ci/ansible/playbook.yml",
      "managerFilePatterns": ["/^ci/ansible/playbook\\.yml$/"],
      "matchStrings": ["woodpecker_version_override \\| default\\('(?<currentValue>\\d+(?:\\.\\d+)*)'\\)"],
      "depNameTemplate": "woodpecker-ci/woodpecker",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
    },
  ],

  "packageRules": [
    // ---- Global policy ------------------------------------------------------
    {
      "description": "Major bumps need a human: surface on the dashboard, don't auto-open PRs",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
    },
    {
      // Belt-and-braces: these are normally referenced as ${..._IMAGE} (skipped by the
      // regex), and the real registry org lives in private config — so match on the
      // image name, not the org.
      "description": "Internal CI-built images (mothertree-*) are versioned by image-versions.env, never by Renovate",
      "matchPackageNames": ["/^ghcr\\.io\\/[^/]+\\/mothertree-/"],
      "enabled": false,
    },

    // ---- Low-risk batching --------------------------------------------------
    // Every PR here costs a full dev deploy + 10 e2e shards against a 2-tenant
    // lease pool, so PR COUNT is the real cost driver — grouping cuts it harder
    // than any rate limit can. Only genuinely low-risk streams are batched;
    // anything stateful or tenant-facing (postgres, redis, nextcloud, stalwart,
    // postfix, pgbouncer, coturn, jitsi, impress, keycloak, tailscale, the LLM
    // stack) deliberately stays one-PR-per-dep so a bad bump is easy to bisect.
    //
    // Each group is scoped to minor/patch/digest ONLY: a major must still land on
    // the Dependency Dashboard on its own, so batching cannot smuggle one through
    // or let one held major block the rest of its group.
    //
    // Each group is also prPriority -1 so that under the 2/hour cap these always
    // yield to everything else. Without it a tooling bump can occupy a scarce
    // slot ahead of an internet-facing component (Stalwart, ingress-nginx,
    // Postfix, Synapse), which would trade burst-safety for CVE latency.
    {
      // Currently inert: every action is pinned to a bare major tag
      // (actions/checkout@v4, ...), so Renovate only ever offers MAJOR updates
      // for them and those stay dashboard-gated above. The rule is kept because
      // it starts paying off the moment actions are SHA-pinned — which is the
      // real supply-chain win here, since a bare tag can be re-pushed.
      "description": "GitHub Actions: one PR for all of them (CI workflow only, never touches the deployed platform)",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "prPriority": -1,
    },
    {
      // Generic base images and one CLI, all exercised by the normal dev deploy
      // + e2e path. Deliberately EXCLUDED, each keeping its own PR:
      //   alpine/k8s      — runs the tailscale-key-rotator (HEADSCALE_API_KEY),
      //                     headscale-cleanup and acme-challenge-cleanup
      //                     (CF_API_TOKEN) CronJobs. Cron-driven, so a bad bump
      //                     fails silently at the next tick, not in CI.
      //   alpine/kubectl  — only usage is inside the Jitsi JVB manifest.
      //   chrll/microsocks— single-maintainer Docker Hub namespace, and the
      //                     artifact is a SOCKS5 proxy; a digest bump there
      //                     deserves its own review, not a batch.
      //   bitnami/kubectl — pinned to :latest, so Renovate cannot version it at
      //                     all; listing it would be false assurance. Pin it to
      //                     a real tag to bring it under management.
      "description": "Generic base/CLI images in one PR",
      "matchPackageNames": [
        "alpine",
        "busybox",
        "python",
        "node",
        "amazon/aws-cli",
        "alpine/socat",
      ],
      "groupName": "base-images",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "prPriority": -1,
    },
    {
      // Note: matrix-alertmanager-receiver uses calver, and the rule further
      // down makes a year rollover (2026.x -> 2027.x) a MAJOR — so that update
      // leaves this group and opens on its own. That is correct, just not what
      // "grouped" might suggest.
      "description": "Internal monitoring/alerting sidecars in one PR (not tenant-facing)",
      "matchPackageNames": [
        "prom/statsd-exporter",
        "prom/pushgateway",
        "metio/matrix-alertmanager-receiver",
      ],
      "groupName": "monitoring",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "prPriority": -1,
    },

    // ---- Keycloak (CVE-2026-18963 class) --------------------------------------
    // Keycloak image + codecentric chart + magic-link jar move together so an
    // upgrade PR shows all three; scripts/localhost/lib-keycloak.sh reads the
    // tag from keycloak-codecentric.yaml, so there is one source of truth.
    {
      "description": "Keycloak: image, chart and extension jar in one PR",
      "matchPackageNames": ["quay.io/keycloak/keycloak", "keycloakx", "io.phasetwo.keycloak:keycloak-magic-link"],
      "groupName": "keycloak",
      "prPriority": 10,
      "prBodyNotes": [
        "If this bumps `keycloak-magic-link`, also update `ML_SHA256` in `apps/values/keycloak-codecentric.yaml` (`curl -sL https://repo1.maven.org/maven2/io/phasetwo/keycloak/keycloak-magic-link/<ver>/keycloak-magic-link-<ver>.jar | sha256sum`, cross-check against the artifact's `.sha1`). The init container refuses the jar on mismatch, so CI fails until this is done.",
        "Check the magic-link release notes for the minimum Keycloak version (0.72+ is required on KC >= 26.6.3).",
      ],
    },

    // ---- Jitsi -------------------------------------------------------------------
    // jitsi/{web,jicofo,prosody,jvb} use `stable-NNNNN` tags and must match.
    {
      "description": "Jitsi stable-NNNNN tags: single numeric stream, keep the four images in lock-step",
      "matchPackageNames": ["jitsi/web", "jitsi/jicofo", "jitsi/prosody", "jitsi/jvb"],
      "versioning": "regex:^stable-(?<major>\\d+)$",
      "groupName": "jitsi",
      "dependencyDashboardApproval": false,
    },
    {
      "description": "nordeck jitsi-keycloak-adapter uses vYYYYMMDD tags",
      "matchPackageNames": ["ghcr.io/nordeck/jitsi-keycloak-adapter"],
      "versioning": "regex:^v(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$",
      "dependencyDashboardApproval": false,
    },

    // ---- Docs (La Suite Impress) ----------------------------------------------------
    {
      "description": "Impress backend/frontend/y-provider ship as one release",
      "matchPackageNames": ["/^lasuite\\/impress-/"],
      "groupName": "docs-impress",
    },

    // ---- Nextcloud -----------------------------------------------------------------
    // The `nextcloud:X-apache` image in values/manifests MUST match the image the
    // chart ships (see comment in apps/values/nextcloud.yaml.gotmpl). Bump the
    // image only alongside the chart; never let the image jump a major on its own.
    {
      "description": "Nextcloud chart + seed/install image in one PR",
      "matchPackageNames": ["nextcloud", "nextcloud/nextcloud", "icewind1991/notify_push"],
      "groupName": "nextcloud",
    },
    {
      "description": "Nextcloud image majors come from the chart, not from Docker Hub",
      "matchPackageNames": ["nextcloud"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
    },

    // ---- LLM stack -------------------------------------------------------------------
    {
      "description": "Ollama + Open WebUI + SearXNG reviewed together (dev memory pressure, gate config)",
      "matchPackageNames": ["ollama/ollama", "openwebui/open-webui", "searxng/searxng"],
      "groupName": "llm",
    },
    {
      "description": "SearXNG tags are YYYY.M.D-<sha>; treat the sha as build metadata",
      "matchPackageNames": ["searxng/searxng"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>[a-f0-9]+)$",
      "dependencyDashboardApproval": false,
    },

    // ---- Calver-ish tags where a year rollover is not a real "major" ----------------
    {
      "description": "matrix-alertmanager-receiver uses YYYY.MM.DD tags",
      "matchPackageNames": ["metio/matrix-alertmanager-receiver"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "dependencyDashboardApproval": false,
    },

    // ---- Mesh / CI infra --------------------------------------------------------------
    {
      "description": "Tailscale sidecars (pgbouncer, router, metrics bridges) share one dep — Renovate already merges them into one PR; flag it",
      "matchPackageNames": ["tailscale/tailscale", "juanfont/headscale"],
      "groupName": "tailscale-mesh",
    },
    {
      "description": "Woodpecker upgrade is applied by ci/provision-ci.sh --ansible-only, not by merge",
      "matchPackageNames": ["woodpecker-ci/woodpecker"],
      "prBodyNotes": [
        "Merging does NOT upgrade the CI VM. Apply with `ci/provision-ci.sh --ansible-only` while no pipelines are running (Valkey leases are recreated — see issue #547).",
      ],
    },

    // ---- Helm charts --------------------------------------------------------------------
    {
      "description": "Helm chart bumps: one PR per chart (deploy independently)",
      "matchManagers": ["helmfile"],
      "additionalBranchPrefix": "helm-",
    },
  ],
}
